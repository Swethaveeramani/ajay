{
  "entities": {
    "Memory": {
      "title": "Memory",
      "description": "A single photo memory with metadata",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "Data URL or Cloud Storage URL of the image" },
        "title": { "type": "string", "description": "Title of the memory" },
        "age": { "type": "string", "description": "Age or time period of the memory" },
        "description": { "type": "string", "description": "A short story or note about the memory" },
        "ownerId": { "type": "string", "description": "UID of the user who owns this memory" },
        "index": { "type": "number", "description": "Ordering index of the memory" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "title", "ownerId", "index"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "audioUrl": { "type": "string", "description": "URL or base64 of the first background music" },
        "audioUrl2": { "type": "string", "description": "URL or base64 of the second background music" },
        "activeTrack": { "type": "number", "description": "Which track is currently active (1 or 2)" },
        "ownerId": { "type": "string", "description": "UID of the owner" }
      },
      "required": ["ownerId"]
    }
  },
  "firestore": {
    "memories/{memoryId}": {
      "schema": "Memory",
      "description": "Collection of birthday memories"
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "App settings like background music"
    }
  }
}
